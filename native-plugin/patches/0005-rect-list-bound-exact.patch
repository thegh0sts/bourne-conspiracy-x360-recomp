@@ -636,7 +636,13 @@ bool Renderer::RectListBound(const rg::RegisterFile& regs, const ShaderCache::Sh
     max_x = std::max(max_x, xy[0]), max_y = std::max(max_y, xy[1]);
   }
   if (max_x > 16384.0f || max_y > 16384.0f) return false;
