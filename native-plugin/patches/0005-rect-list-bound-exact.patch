+  // transfer copied one 4x pixel (two columns) of uncleared depth over the strip (ultrawide widths such as 1720:
+  // black columns 1680-1681 in UE3's shadow mask, a dark line on screen).
+  x1 = uint32_t(std::ceil(max_x + 0.5f)), y1 = uint32_t(std::ceil(max_y + 0.5f));
   return true;
