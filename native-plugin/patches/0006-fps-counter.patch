+  std::string cpu;
+  uint64_t v[8] = {};
+  if (stat >> cpu >> v[0] >> v[1] >> v[2] >> v[3] >> v[4] >> v[5] >> v[6] >> v[7] && cpu == "cpu") {
+    const uint64_t idle = v[3] + v[4], total = v[0] + v[1] + v[2] + v[3] + v[4] + v[5] + v[6] + v[7];
+    t.total_us = total * 10000, t.busy_us = (total - idle) * 10000;  // USER_HZ ticks, normally 100 a second
+  }
+#endif
+  return t;
