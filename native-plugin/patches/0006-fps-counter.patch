+      const char* at = std::strchr(kChars, ch);
+      const uint32_t code = at && ch ? uint32_t(at - kChars) : 0;
+      const uint32_t i = l * kOverlayColumns + c;
+      overlay_text_[i / 4] |= code << (8 * (i % 4));
