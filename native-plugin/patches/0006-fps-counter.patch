+double Renderer::VramUsedMB() const {
+  if (!allocator_) return 0.0;
+  VmaBudget budgets[VK_MAX_MEMORY_HEAPS] = {};
+  vmaGetHeapBudgets(allocator_, budgets);
+  const VkPhysicalDeviceMemoryProperties* memory = nullptr;
+  vmaGetMemoryProperties(allocator_, &memory);
+  uint64_t used = 0;
+  for (uint32_t i = 0; memory && i < memory->memoryHeapCount; ++i) {
+    if (memory->memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) used += budgets[i].usage;
+  }
+  return double(used) / 1048576.0;
+}
