 }
 
+// tbc FPS counter: render_scale.w (frames per second, 0 = off) as seven-segment digits on a dark box in the
+// top-left corner, drawn here so it costs nothing extra and shows in exclusive / direct-flip fullscreen too (a
+// separate overlay window can't). Digit height h output pixels; a digit is 0.55h wide.
+// Segment bits: 0 top, 1 top right, 2 bottom right, 3 bottom, 4 bottom left, 5 top left, 6 middle.
+const uint kSegments[10] = uint[10](0x3Fu, 0x06u, 0x5Bu, 0x4Fu, 0x66u, 0x6Du, 0x7Du, 0x07u, 0x7Fu, 0x6Fu);
+
+bool InBox(vec2 p, vec2 lo, vec2 hi) { return all(greaterThanEqual(p, lo)) && all(lessThan(p, hi)); }
+
+// p: position in the digit in units of its height (x 0-0.55, y 0-1 downwards).
+bool DigitLit(vec2 p, uint digit) {
+  const float w = 0.55, t = 0.12;
+  uint s = kSegments[min(digit, 9u)];
+  return ((s & 1u) != 0u && InBox(p, vec2(t, 0.0), vec2(w - t, t))) ||
+         ((s & 2u) != 0u && InBox(p, vec2(w - t, 0.0), vec2(w, 0.5 + t * 0.5))) ||
+         ((s & 4u) != 0u && InBox(p, vec2(w - t, 0.5 - t * 0.5), vec2(w, 1.0))) ||
+         ((s & 8u) != 0u && InBox(p, vec2(t, 1.0 - t), vec2(w - t, 1.0))) ||
+         ((s & 16u) != 0u && InBox(p, vec2(0.0, 0.5 - t * 0.5), vec2(t, 1.0))) ||
+         ((s & 32u) != 0u && InBox(p, vec2(0.0, 0.0), vec2(t, 0.5 + t * 0.5))) ||
+         ((s & 64u) != 0u && InBox(p, vec2(t, 0.5 - t * 0.5), vec2(w - t, 0.5 + t * 0.5)));
+}
+
+vec4 FpsOverlay(vec2 pixel, vec4 color, float fps) {
+  float h = max(14.0, floor(float(textureSize(source, 0).y) / render_scale.x / 32.0));
+  uint value = uint(clamp(round(fps), 0.0, 999.0));
+  uint count = value >= 100u ? 3u : (value >= 10u ? 2u : 1u);
+  float advance = 0.8 * h;  // digit width + gap
+  vec2 origin = vec2(0.6 * h);  // the digits' top-left; the box has 0.3h of padding round them
+  vec2 lo = origin - 0.3 * h, hi = origin + vec2(float(count) * advance - 0.25 * h, h) + 0.3 * h;
+  if (!InBox(pixel, lo, hi)) return color;
+  vec4 result = vec4(mix(color.rgb, vec3(0.06, 0.07, 0.09), 0.8), color.a);
+  vec2 p = (pixel - origin) / h;
+  uint k = uint(max(floor(p.x / 0.8), 0.0));
+  if (k >= count || p.y < 0.0 || p.y >= 1.0) return result;
+  uint digit = (value / (k == count - 1u ? 1u : (k == count - 2u ? 10u : 100u))) % 10u;
+  if (!DigitLit(vec2(p.x - float(k) * 0.8, p.y), digit)) return result;
+  vec3 ink = fps >= 55.0 ? vec3(0.47, 0.86, 0.47) : (fps >= 28.0 ? vec3(0.92, 0.78, 0.35) : vec3(0.92, 0.35, 0.35));
+  return vec4(ink, color.a);
+}
+
 void main() {
   // Output pixel centres -> source texels (the front buffer is render_scale.x of the output's size; 1 above render
   // scale 1, where the output is the rendered size). At 1 that is each texel's centre, read as is; below 1 it
@@ -60,6 +99,7 @@ void main() {
                                  : textureLod(source, vec3(position / size, 0.0), 0.0).rgb;
   result = vec4(float((Ramp(c.r) >> 20) & 0x3FFu), float((Ramp(c.g) >> 10) & 0x3FFu), float(Ramp(c.b) & 0x3FFu),
                 1023.0) / 1023.0;
+  if (render_scale.w > 0.0) result = FpsOverlay(gl_FragCoord.xy, result, render_scale.w);
 }
 )";
 
