+             : (fps >= 55.0 ? vec3(0.47, 0.86, 0.47) : (fps >= 28.0 ? vec3(0.92, 0.78, 0.35) : vec3(0.92, 0.35, 0.35)));
+  return vec4(ink, color.a);
+}
