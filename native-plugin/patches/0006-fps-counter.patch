+void Renderer::SetToast(float alpha, const std::string& name, const std::string& suffix, const uint32_t* icon) {
+  toast_alpha_ = alpha;
+  std::memset(toast_text_, 0, sizeof(toast_text_));
+  static constexpr char kTitle[] = "Achievement Unlocked";
+  const uint32_t name_length = uint32_t(std::min<size_t>(name.size(), 48));
+  const uint32_t suffix_length = uint32_t(std::min<size_t>(suffix.size(), 12));
+  auto put = [&](uint32_t i, char c) { toast_text_[i / 4] |= uint32_t(uint8_t(c)) << (8 * (i % 4)); };
+  for (uint32_t i = 0; i < 20; ++i) put(i, kTitle[i]);
+  for (uint32_t i = 0; i < name_length; ++i) put(20 + i, name[i]);
+  for (uint32_t i = 0; i < suffix_length; ++i) put(20 + name_length + i, suffix[i]);
+  toast_name_length_ = name_length;
+  toast_suffix_length_ = suffix_length;
+  toast_has_icon_ = icon != nullptr;
+  if (icon) std::memcpy(toast_icon_, icon, sizeof(toast_icon_));
+}
+
+void Renderer::AddFrameTime(double ms) {
+  overlay_graph_ = true;
+  frame_times_[frame_time_head_] = uint8_t(std::clamp(ms * 4.0 + 0.5, 0.0, 255.0));
+  frame_time_head_ = (frame_time_head_ + 1) % kGraphFrames;
+}
+
+double Renderer::VramUsedMB() const {
+  if (!allocator_) return 0.0;
+  VmaBudget budgets[VK_MAX_MEMORY_HEAPS] = {};
+  vmaGetHeapBudgets(allocator_, budgets);
+  const VkPhysicalDeviceMemoryProperties* memory = nullptr;
+  vmaGetMemoryProperties(allocator_, &memory);
+  uint64_t used = 0;
+  for (uint32_t i = 0; memory && i < memory->memoryHeapCount; ++i) {
+    if (memory->memoryHeaps[i].flags & VK_MEMORY_HEAP_DEVICE_LOCAL_BIT) used += budgets[i].usage;
+  }
+  return double(used) / 1048576.0;
+}
