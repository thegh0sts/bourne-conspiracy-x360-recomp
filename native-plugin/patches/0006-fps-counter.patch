+
+// Achievement pop-up (tbc), drawn like the runtime's ImGui one (rex::ui::AchievementToastDialog with the ImGuiDrawer
+// style): a 320x70 window 16 px in from the bottom-right corner (80 + 16 from the bottom), dark green at 88% with a
+// 1 px border and 6 px corners; the 44x44 icon at (8, 8); "Achievement Unlocked" (yellow) at (60, 8); the name (white)
+// at (60, 22) and its gamerscore in grey 8 px after it; ProggyTiny 10 px. Sizes are ImGui pixels at 1080 output lines, scaled
+// by whole steps above. toast.x fades the lot.
+bool ToastGlyph(uint ch, uint gx, uint gy) {
+  uint code = (ch >= 32u && ch < 127u) ? ch - 32u : 31u;  // others: '?'
+  uint bit = gy * 6u + gx;
+  uint w = code * 2u + (bit >> 5u);
+  return ((toast_font[w >> 2u][w & 3u] >> (bit & 31u)) & 1u) != 0u;
+}
+
+uint ToastChar(uint i) { return (toast_text[i >> 4u][(i >> 2u) & 3u] >> ((i & 3u) * 8u)) & 0xFFu; }
+
+vec4 Toast(vec2 pixel, vec4 color) {
+  float a = uintBitsToFloat(toast.x);
+  vec2 out_size = vec2(textureSize(source, 0).xy) / render_scale.xy;
+  float s = max(1.0, round(out_size.y / 1080.0));
+  vec2 p = (pixel - (out_size - vec2(336.0, 96.0) * s)) / s;  // ImGui pixels in the window
+  if (p.x < 0.0 || p.y < 0.0 || p.x >= 320.0 || p.y >= 70.0) return color;
+  vec2 q = min(p, vec2(320.0, 70.0) - p);  // distance to the nearest edges
+  float corner = (q.x < 6.0 && q.y < 6.0) ? length(vec2(6.0) - q) : 0.0;
+  if (corner > 6.0) return color;
+  if (q.x < 1.0 || q.y < 1.0 || corner > 5.0) return vec4(mix(color.rgb, vec3(0.0, 0.35, 0.0), a), color.a);
+  vec3 c = mix(color.rgb, vec3(0.0, 0.06, 0.0), 0.88 * a);
+  if (toast.w != 0u && p.x >= 8.0 && p.y >= 8.0 && p.x < 52.0 && p.y < 52.0) {
+    uvec2 ip = uvec2(p - 8.0);
+    uint i = ip.y * 44u + ip.x;
+    vec4 icon = unpackUnorm4x8(toast_icon[i >> 2u][i & 3u]);
+    return vec4(mix(c, icon.rgb, icon.a * a), color.a);
+  }
+  uvec2 t = uvec2(p);
+  if (t.x < 60u || t.x >= 316u) return vec4(c, color.a);
+  uint x = t.x - 60u;
+  vec3 ink;
+  uint ch;
+  if (t.y >= 8u && t.y < 18u) {
+    if (x >= 20u * 6u) return vec4(c, color.a);
+    ch = ToastChar(x / 6u);
+    ink = vec3(1.0, 0.85, 0.2);
+  } else if (t.y >= 22u && t.y < 32u) {
+    uint name = toast.y * 6u, suffix_at = name + 8u;
+    if (x < name) {
+      ch = ToastChar(20u + x / 6u);
+      ink = vec3(1.0);
+    } else if (x >= suffix_at && x < suffix_at + toast.z * 6u) {
+      x -= suffix_at;
+      ch = ToastChar(20u + toast.y + x / 6u);
+      ink = vec3(0.6);
+    } else {
+      return vec4(c, color.a);
+    }
+  } else {
+    return vec4(c, color.a);
+  }
+  uint gy = (t.y - 8u) % 14u;
+  if (!ToastGlyph(ch, x % 6u, gy)) return vec4(c, color.a);
+  return vec4(mix(c, ink, a), color.a);
+}
