+void Renderer::SetOverlay(float fps, const std::vector<std::string>& lines) {
+  static constexpr char kChars[] = " 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ.%()/:-";
+  overlay_fps_ = fps;
+  std::memset(overlay_text_, 0, sizeof(overlay_text_));
+  overlay_lines_ = uint32_t(std::min<size_t>(lines.size(), kOverlayLines));
+  overlay_cols_ = 0;
+  for (uint32_t l = 0; l < overlay_lines_; ++l) {
+    const std::string& line = lines[l];
+    const uint32_t n = uint32_t(std::min<size_t>(line.size(), kOverlayColumns));
+    overlay_cols_ = std::max(overlay_cols_, n);
+    for (uint32_t c = 0; c < n; ++c) {
+      const char ch = char(std::toupper(static_cast<unsigned char>(line[c])));
+      const char* at = std::strchr(kChars, ch);
+      const uint32_t code = at && ch ? uint32_t(at - kChars) : 0;
+      const uint32_t i = l * kOverlayColumns + c;
+      overlay_text_[i / 4] |= code << (8 * (i % 4));
+    }
+  }
+}
