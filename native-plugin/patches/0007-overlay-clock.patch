--- a/src/gfx/native.cpp
+++ b/src/gfx/native.cpp
@@ -16,6 +16,7 @@
 #include <cstdio>
 #include <cstdlib>
 #include <cstring>
+#include <ctime>
 #include <filesystem>
 #include <iterator>
 #include <mutex>
@@ -451,7 +452,11 @@ class NativeCommandProcessor final : public rg::CommandProcessor {
     fps_last_ = now;
     ++fps_frames_;
     const double seconds = std::chrono::duration<double>(now - fps_start_).count();
-    if (seconds < 0.5) return;
+    if (seconds < 0.5) {
+      // The clock line moves on every tenth of a second, between the half-second statistics.
+      if (UpdateClock()) renderer_->SetOverlay(fps_last_value_, WithClock(fps_last_lines_));
+      return;
+    }
     const double frames = double(fps_frames_ - 1);
     const double fps = frames / seconds;
     std::vector<std::string> lines;
@@ -488,11 +493,37 @@ class NativeCommandProcessor final : public rg::CommandProcessor {
       fps_cpu_ = cpu;
       fps_system_ = system;
     }
-    renderer_->SetOverlay(float(fps), lines);
+    fps_last_value_ = float(fps);
+    fps_last_lines_ = lines;
+    UpdateClock();
+    renderer_->SetOverlay(fps_last_value_, WithClock(fps_last_lines_));
     fps_frames_ = 1;
     fps_start_ = now;
     fps_worst_ms_ = 0.0;
   }
+  // tbc: the PC's local time under the frame rate, to a tenth of a second, as the game log writes it, so a video
+  // recording of the game can be matched to the log. True when the shown time changed.
+  bool UpdateClock() {
+    const auto now = std::chrono::system_clock::now();
+    const std::time_t t = std::chrono::system_clock::to_time_t(now);
+    const int tenths =
+        int(std::chrono::duration_cast<std::chrono::milliseconds>(now.time_since_epoch()).count() % 1000 / 100);
+    std::tm local{};
+#ifdef _WIN32
+    localtime_s(&local, &t);
+#else
+    localtime_r(&t, &local);
+#endif
+    char buf[16];
+    std::snprintf(buf, sizeof(buf), "%02d:%02d:%02d.%d", local.tm_hour, local.tm_min, local.tm_sec, tenths);
+    if (fps_clock_ == buf) return false;
+    fps_clock_ = buf;
+    return true;
+  }
+  std::vector<std::string> WithClock(std::vector<std::string> lines) const {
+    lines.push_back(fps_clock_);
+    return lines;
+  }
   // tbc: achievement pop-ups, drawn by the present pass (Renderer::SetToast) like the runtime's ImGui one, which the
   // game turns off with this renderer (tbc_app.h). --achievement_popups=false: none. As the runtime's: each shows for
   // 4.5 s, fading in over 0.3 s and out over the last 0.5, one after another.
@@ -603,6 +634,9 @@ class NativeCommandProcessor final : public rg::CommandProcessor {
   }
   uint64_t fps_frames_ = 0, fps_gpu_ns_ = 0;
   double fps_worst_ms_ = 0.0;
+  float fps_last_value_ = 0.0f;
+  std::vector<std::string> fps_last_lines_;
+  std::string fps_clock_;
   std::chrono::steady_clock::time_point fps_start_{}, fps_last_{};
   host::CpuTimes fps_cpu_;
   host::SystemCpu fps_system_;
