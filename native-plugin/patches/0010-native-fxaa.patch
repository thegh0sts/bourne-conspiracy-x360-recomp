+// tbc FXAA (render_scale.y: 1, 2 strong; 0 off), the SDK's swap FXAA (its Xenos path, --swap_post_effect) on the
+// front buffer before the gamma ramp, so the tbc overlay and the achievement pop-up drawn after it stay sharp. The
+// game's own HUD is already in the front buffer, so it gets the same light smoothing as everything else.
+float Luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }
+
+vec3 Fxaa(vec2 uv, vec2 texel, bool strong) {
+  float edge_threshold = strong ? 0.063 : 0.166, edge_threshold_min = strong ? 0.0312 : 0.0833;
+  float span_max = strong ? 12.0 : 8.0;
+  const float kDirReduceMul = 0.125, kDirReduceMin = 1.0 / 128.0;
+  vec3 rgb_m = textureLod(source, vec3(uv, 0.0), 0.0).rgb;
+  float luma_m = Luma(rgb_m);
+  float luma_nw = Luma(textureLod(source, vec3(uv + vec2(-texel.x, -texel.y), 0.0), 0.0).rgb);
+  float luma_ne = Luma(textureLod(source, vec3(uv + vec2(texel.x, -texel.y), 0.0), 0.0).rgb);
+  float luma_sw = Luma(textureLod(source, vec3(uv + vec2(-texel.x, texel.y), 0.0), 0.0).rgb);
+  float luma_se = Luma(textureLod(source, vec3(uv + vec2(texel.x, texel.y), 0.0), 0.0).rgb);
+  float luma_min = min(luma_m, min(min(luma_nw, luma_ne), min(luma_sw, luma_se)));
+  float luma_max = max(luma_m, max(max(luma_nw, luma_ne), max(luma_sw, luma_se)));
+  if (luma_max - luma_min < max(edge_threshold_min, luma_max * edge_threshold)) return rgb_m;
+  vec2 dir = vec2(-((luma_nw + luma_ne) - (luma_sw + luma_se)), (luma_nw + luma_sw) - (luma_ne + luma_se));
+  float dir_reduce = max((luma_nw + luma_ne + luma_sw + luma_se) * (0.25 * kDirReduceMul), kDirReduceMin);
+  float rcp_dir_min = 1.0 / (min(abs(dir.x), abs(dir.y)) + dir_reduce);
+  dir = clamp(dir * rcp_dir_min, vec2(-span_max), vec2(span_max)) * texel;
+  vec3 rgb_a = 0.5 * (textureLod(source, vec3(uv + dir * (1.0 / 3.0 - 0.5), 0.0), 0.0).rgb +
+                      textureLod(source, vec3(uv + dir * (2.0 / 3.0 - 0.5), 0.0), 0.0).rgb);
+  vec3 rgb_b = rgb_a * 0.5 + 0.25 * (textureLod(source, vec3(uv + dir * -0.5, 0.0), 0.0).rgb +
+                                     textureLod(source, vec3(uv + dir * 0.5, 0.0), 0.0).rgb);
+  float luma_b = Luma(rgb_b);
+  return (luma_b < luma_min || luma_b > luma_max) ? rgb_a : rgb_b;
+}
