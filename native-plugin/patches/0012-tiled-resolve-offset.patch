+uint32_t Renderer::TiledResolveBase(uint32_t address, uint32_t format, uint32_t width, uint32_t height,
+                                    VkOffset2D& offset) {
+  offset = {0, 0};
+  const rg::FormatInfo* info = rg::FormatInfo::Get(format & 0x3F);
+  if (!info || !width || !height) return address;
+  const uint32_t bytes = info->bytes_per_block();
+  const uint32_t tile_bytes = 32 * 32 * bytes;  // the 360's tiled 2D layout: 32x32-texel blocks, row by row
+  const uint32_t tiles_x = (width + 31) / 32, tiles_y = (height + 31) / 32;
+  for (const auto& [key, image] : textures_) {
+    const auto [base, key_format, key_width, key_height] = key;
+    if (!image || base >= address || key_format != format || key_width != width || key_height != height) continue;
+    const uint32_t delta = address - base;
+    if (delta % tile_bytes || delta / tile_bytes >= tiles_x * tiles_y) continue;
+    const uint32_t tile = delta / tile_bytes;
+    offset = {int32_t(Host((tile % tiles_x) * 32)), int32_t(Host((tile / tiles_x) * 32))};
+    return base;
+  }
+  return address;
+}
