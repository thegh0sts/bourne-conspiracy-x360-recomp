diff --git a/src/gfx/vk/draw.cpp b/src/gfx/vk/draw.cpp
index 1d96bab..30bb97b 100644
--- a/src/gfx/vk/draw.cpp
+++ b/src/gfx/vk/draw.cpp
@@ -839,6 +839,38 @@ void Renderer::IssueDraw(const rg::RegisterFile& regs, const ShaderLoad& vs, con
       }
     }
     consts(rg::XE_GPU_REG_SHADER_CONSTANT_000_X, "vc");
+    // tbc (007's menu): each vertex binding's fetch constant and its first vertices, raw (as in guest memory) and
+    // byte-swapped by the fetch constant's endianness.
+    // (vf0 only: the bindings list may not be filled in yet when this runs; the stride is in the disassembly.)
+    struct DumpBinding {
+      uint32_t fetch_constant, stride_words;
+    };
+    for (const DumpBinding binding : {DumpBinding{0, 0}}) {
+      const auto fetch = regs.GetVertexFetch(binding.fetch_constant);
+      std::fprintf(stderr, "  vf%u: type %u words %08X %08X address %08X size %u words endian %u, index offset %d min %u max %u\n",
+                   binding.fetch_constant, uint32_t(fetch.type),
+                   regs.values[rg::XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + 2 * binding.fetch_constant],
+                   regs.values[rg::XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0 + 2 * binding.fetch_constant + 1],
+                   uint32_t(fetch.address) << 2, uint32_t(fetch.size), uint32_t(fetch.endian),
+                   int32_t(regs.values[rg::XE_GPU_REG_VGT_INDX_OFFSET]), regs.values[rg::XE_GPU_REG_VGT_MIN_VTX_INDX],
+                   regs.values[rg::XE_GPU_REG_VGT_MAX_VTX_INDX]);
+      const uint8_t* data = memory_(uint32_t(fetch.address) << 2);
+      if (!data) continue;
+      const uint32_t words = std::min<uint32_t>(fetch.size, 42);
+      std::string raw, swapped;
+      for (uint32_t i = 0; i < words; ++i) {
+        uint32_t w;
+        std::memcpy(&w, data + 4 * i, 4);
+        char t[24];
+        std::snprintf(t, sizeof(t), "%s%08X", i && binding.stride_words && i % binding.stride_words == 0 ? " | " : " ",
+                      w);
+        raw += t;
+        std::snprintf(t, sizeof(t), "%s%08X", i && binding.stride_words && i % binding.stride_words == 0 ? " | " : " ",
+                      xe::GpuSwap(w, fetch.endian));
+        swapped += t;
+      }
+      std::fprintf(stderr, "    raw:%s\n    swapped:%s\n", raw.c_str(), swapped.c_str());
+    }
     if (pshader) {
       std::fprintf(stderr, "--- pixel shader %08X\n%s", ps.address, pshader->ucode_disassembly().c_str());
       consts(rg::XE_GPU_REG_SHADER_CONSTANT_256_X, "c");
