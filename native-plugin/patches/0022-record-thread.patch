+void Renderer::DrawPacket::Record(const Api& vk, VkCommandBuffer cmd, bool draw) const {
+  if (bind_pipeline) vk.vkCmdBindPipeline(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
