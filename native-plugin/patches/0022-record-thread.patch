+    if (bind_mask & (1u << i)) vk.vkCmdBindDescriptorSets(cmd, VK_PIPELINE_BIND_POINT_GRAPHICS, layout, i, 1, &sets[i], 0, nullptr);
+  }
+  if (!draw) return;
+  if (dyn_mask & 1) vk.vkCmdSetViewport(cmd, 0, 1, &state.viewport);
+  if (dyn_mask & 2) vk.vkCmdSetScissor(cmd, 0, 1, &state.scissor);
+  if (dyn_mask & 4) vk.vkCmdSetDepthBias(cmd, state.bias[0], 0.0f, state.bias[1]);
+  if (dyn_mask & 8) vk.vkCmdSetBlendConstants(cmd, state.blend);
+  const uint32_t* s = state.stencil;
+  if (dyn_mask & 16) vk.vkCmdSetStencilReference(cmd, VK_STENCIL_FACE_FRONT_BIT, s[0]);
+  if (dyn_mask & 32) vk.vkCmdSetStencilReference(cmd, VK_STENCIL_FACE_BACK_BIT, s[1]);
+  if (dyn_mask & 64) vk.vkCmdSetStencilCompareMask(cmd, VK_STENCIL_FACE_FRONT_BIT, s[2]);
+  if (dyn_mask & 128) vk.vkCmdSetStencilCompareMask(cmd, VK_STENCIL_FACE_BACK_BIT, s[3]);
+  if (dyn_mask & 256) vk.vkCmdSetStencilWriteMask(cmd, VK_STENCIL_FACE_FRONT_BIT, s[4]);
+  if (dyn_mask & 512) vk.vkCmdSetStencilWriteMask(cmd, VK_STENCIL_FACE_BACK_BIT, s[5]);
+  if (indexed) {
+    vk.vkCmdBindIndexBuffer(cmd, index_buffer, index_offset, index_type);
+    vk.vkCmdDrawIndexed(cmd, count, 1, 0, 0, 0);
+  } else {
+    vk.vkCmdDraw(cmd, count, 1, 0, 0);
+  }
