diff --git a/src/gfx/vk/recorder.h b/src/gfx/vk/recorder.h
new file mode 100644
index 0000000..fd387e1
--- /dev/null
+++ b/src/gfx/vk/recorder.h
@@ -0,0 +1,190 @@
+#pragma once
+
+// qos (patch 0093, BOTS_GFX_RECORD_THREAD=1): DXVK's CS-thread model for the renderer's hot path. The CP thread
+// translates a draw (textures, indices, constants, descriptor sets, pipeline, pass) and hands its Vulkan commands
+// to a worker as a packet; the worker records them into the command buffer in order while the CP thread goes on to
+// the next draw. Anything that records directly (Renderer::Cmd(): resolves, uploads, transfers, present, flush)
+// first waits until the worker has recorded everything handed to it, so the command buffer keeps one order and is
+// only ever used by one thread at a time.
+//
+// Single producer (the CP thread), single consumer (the worker). Packets are closures constructed in place in a
+// byte ring; the worker runs each with the command buffer it was pushed for, then destroys it.
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <new>
+#include <thread>
+#include <type_traits>
+#include <utility>
+
+#include <vulkan/vulkan.h>
+
+#if defined(_M_X64) || defined(__x86_64__)
+#include <immintrin.h>
+#endif
+
+namespace bots::gfx::vk {
+
+class Recorder {
+ public:
+  Recorder() : ring_(std::make_unique<std::byte[]>(kRingBytes)), worker_([this] { Run(); }) {}
+  ~Recorder() {
+    Drain();
+    stop_.store(true, std::memory_order_seq_cst);
+    Push(VK_NULL_HANDLE, [](VkCommandBuffer) {});  // moves write_, so a sleeping worker wakes and sees stop_
+    Publish();
+    worker_.join();
+  }
+  Recorder(const Recorder&) = delete;
+  Recorder& operator=(const Recorder&) = delete;
+
+  // Hands `f(cmd)` to the worker. Captures must stay valid on their own (copies, not references to the caller's
+  // stack).
+  template <class F>
+  void Push(VkCommandBuffer cmd, F&& f) {
+    using Fn = std::decay_t<F>;
+    static_assert(alignof(Fn) <= kAlign, "packet over-aligned");
+    constexpr size_t bytes = Round(sizeof(Header) + Round(sizeof(Fn)));
+    static_assert(bytes < kRingBytes / 4, "packet too large");
+    size_t at = Reserve(bytes);
+    Header* h = new (ring_.get() + at) Header{&Invoke<Fn>, uint32_t(bytes), cmd};
+    new (reinterpret_cast<std::byte*>(h) + Round(sizeof(Header))) Fn(std::forward<F>(f));
+    write_pos_ = write_pos_ - (write_pos_ % kRingBytes) + at + bytes;
+    ++pushed_;
+    // Handed over in batches (as DXVK's CS chunks): one atomic store per kBatchBytes, not per packet.
+    if (write_pos_ - published_ >= kBatchBytes) Publish();
+  }
+
+  // Returns once the worker has run every packet pushed so far. Cheap when it already has.
+  void Drain() {
+    Publish();
+    const uint64_t target = write_pos_;
+    if (read_.load(std::memory_order_acquire) == target) return;
+    ++drains_;
+    Wake();
+    for (uint32_t spin = 0; read_.load(std::memory_order_acquire) != target; ++spin) {
+      if (spin < 4096) {
+        Pause();
+      } else {
+        const uint64_t seen = read_.load(std::memory_order_acquire);
+        if (seen != target) read_.wait(seen, std::memory_order_acquire);
+      }
+    }
+  }
+
+  uint64_t pushed() const { return pushed_; }
+  uint64_t drains() const { return drains_; }
+
+ private:
+  static constexpr size_t kRingBytes = size_t(8) << 20;
+  static constexpr size_t kAlign = 16;
+  static constexpr size_t kBatchBytes = 4096;
+  static constexpr size_t Round(size_t n) { return (n + kAlign - 1) & ~(kAlign - 1); }
+
+  struct Header {
+    void (*invoke)(void* fn, VkCommandBuffer cmd);  // null: wrap to the ring's start
+    uint32_t bytes;
+    VkCommandBuffer cmd;
+  };
+
+  template <class Fn>
+  static void Invoke(void* p, VkCommandBuffer cmd) {
+    Fn* fn = static_cast<Fn*>(p);
+    (*fn)(cmd);
+    fn->~Fn();
+  }
+
+  static void Pause() {
+#if defined(_M_X64) || defined(__x86_64__)
+    _mm_pause();
+#endif
+  }
+
+  // Positions are monotonically increasing byte counts; the ring offset is pos % kRingBytes.
+  size_t Reserve(size_t bytes) {
+    size_t offset = size_t(write_pos_ % kRingBytes);
+    if (offset + bytes + sizeof(Header) > kRingBytes) {
+      // Not enough room before the end: a wrap marker, and the packet goes at the start.
+      WaitForRoom(kRingBytes - offset);
+      new (ring_.get() + offset) Header{nullptr, uint32_t(kRingBytes - offset), VK_NULL_HANDLE};
+      write_pos_ += kRingBytes - offset;
+      offset = 0;
+    }
+    WaitForRoom(bytes);
+    return offset;
+  }
+
+  void WaitForRoom(size_t bytes) {
+    if (write_pos_ + bytes + sizeof(Header) - read_.load(std::memory_order_acquire) > kRingBytes) Publish();
+    for (uint32_t spin = 0; write_pos_ + bytes + sizeof(Header) - read_.load(std::memory_order_acquire) > kRingBytes;
+         ++spin) {
+      Wake();
+      if (spin < 4096) {
+        Pause();
+      } else {
+        const uint64_t seen = read_.load(std::memory_order_acquire);
+        if (write_pos_ + bytes + sizeof(Header) - seen > kRingBytes) read_.wait(seen, std::memory_order_acquire);
+      }
+    }
+  }
+
+  void Publish() {
+    if (published_ == write_pos_) return;
+    published_ = write_pos_;
+    write_.store(write_pos_, std::memory_order_seq_cst);
+    if (sleeping_.load(std::memory_order_seq_cst)) Wake();
+  }
+
+  void Wake() { write_.notify_one(); }
+
+  void Run() {
+    uint64_t pos = 0;
+    for (;;) {
+      uint64_t end = write_.load(std::memory_order_acquire);
+      if (end == pos) {
+        if (stop_.load(std::memory_order_acquire)) return;
+        bool got = false;
+        for (uint32_t spin = 0; spin < 2048; ++spin) {
+          Pause();
+          if (write_.load(std::memory_order_acquire) != pos || stop_.load(std::memory_order_acquire)) {
+            got = true;
+            break;
+          }
+        }
+        if (!got) {
+          sleeping_.store(true, std::memory_order_seq_cst);
+          if (write_.load(std::memory_order_seq_cst) == pos && !stop_.load(std::memory_order_acquire)) {
+            write_.wait(pos, std::memory_order_acquire);
+          }
+          sleeping_.store(false, std::memory_order_relaxed);
+        }
+        continue;
+      }
+      while (pos != end) {
+        Header* h = reinterpret_cast<Header*>(ring_.get() + size_t(pos % kRingBytes));
+        if (h->invoke && h->cmd) {
+          h->invoke(reinterpret_cast<std::byte*>(h) + Round(sizeof(Header)), h->cmd);
+        } else if (h->invoke) {
+          h->invoke(reinterpret_cast<std::byte*>(h) + Round(sizeof(Header)), VK_NULL_HANDLE);
+        }
+        pos += h->bytes;
+      }
+      read_.store(pos, std::memory_order_release);
+      read_.notify_all();
+    }
+  }
+
+  std::unique_ptr<std::byte[]> ring_;
+  uint64_t write_pos_ = 0, published_ = 0;  // the producer's own: written so far, and handed over
+  alignas(64) std::atomic<uint64_t> write_{0};
+  alignas(64) std::atomic<uint64_t> read_{0};
+  alignas(64) std::atomic<bool> sleeping_{false};
+  std::atomic<bool> stop_{false};
+  uint64_t pushed_ = 0, drains_ = 0;
+  std::thread worker_;  // last: started once everything above exists
+};
+
+}  // namespace bots::gfx::vk
