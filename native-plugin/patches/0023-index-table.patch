+bool Renderer::IndexFlat() {
+  static const bool on = [] {
+    const char* v = std::getenv("BOTS_GFX_INDEX_FLAT");
+    return !(v && *v == '0');
+  }();
+  return on;
+}
+
+uint32_t Renderer::IndexSlotOf(const IndexKey& key) {
+  uint64_t h = (uint64_t(key.base) << 32 | key.count) ^
+               (uint64_t(key.reset_index) << 8 | key.flags) * 0xC2B2AE3D27D4EB4Full;
+  h ^= h >> 31;
+  h *= 0x9E3779B97F4A7C15ull;
+  return uint32_t(h >> (64 - kIndexSlotBits));
+}
+
+void Renderer::ForgetIndexUploads() {
+  index_uploads_.clear(), index_blocks_.clear();
+  index_slots_used_ = 0;
+  if (++index_flat_gen_ == 0) {  // wrapped: no slot may look current
+    for (IndexSlot& slot : index_slots_) slot.gen = 0;
+    index_flat_gen_ = 1;
+  }
+}
+
+const Renderer::IndexUpload* Renderer::FindIndexUpload(const IndexKey& key) {
+  if (!index_slots_used_) return nullptr;
+  constexpr uint32_t mask = kIndexSlots - 1;
+  for (uint32_t i = IndexSlotOf(key), n = 0; n < kIndexSlots; i = (i + 1) & mask, ++n) {
+    const IndexSlot& slot = index_slots_[i];
+    if (slot.gen != index_flat_gen_) return nullptr;  // an empty slot ends the probe
+    if (!(slot.key == key)) continue;
+    const uint64_t end = uint64_t(key.base) + std::max(slot.upload.bytes, 1u) - 1;
+    const uint32_t last = uint32_t(std::min<uint64_t>(end, UINT32_MAX) >> kIndexPageShift);
+    for (uint32_t page = key.base >> kIndexPageShift; page <= last; ++page) {
+      if (index_page_stamps_[page] > slot.stamp) return nullptr;  // written since: KeepIndexUpload reuses the slot
+    }
+    return &slot.upload;
+  }
+  return nullptr;
+}
+
+void Renderer::KeepIndexUpload(const IndexKey& key, const IndexUpload& upload) {
+  if (index_slots_.empty()) {
+    index_slots_.resize(kIndexSlots);
+    index_page_stamps_.assign(size_t(1) << (32 - kIndexPageShift), 0);
+  }
+  constexpr uint32_t mask = kIndexSlots - 1;
+  for (uint32_t i = IndexSlotOf(key), n = 0; n < kIndexSlots; i = (i + 1) & mask, ++n) {
+    IndexSlot& slot = index_slots_[i];
+    if (slot.gen == index_flat_gen_) {
+      if (!(slot.key == key)) continue;
+    } else {
+      if (index_slots_used_ >= kIndexSlots / 4 * 3) return;  // full enough: this one isn't kept
+      slot.gen = index_flat_gen_;
+      ++index_slots_used_;
+    }
+    slot.key = key, slot.upload = upload, slot.stamp = index_stamp_;
+    return;
+  }
+}
+
+// CPU writes (invalidated_) stamp their pages, so entries made before them are no longer found.
+void Renderer::StampIndexPages() {
+  if (!index_slots_used_ || invalidated_.empty()) return;
+  if (index_stamp_ >= 0xFFFFFFF0u) {  // wrapping: start the stamps over, and the entries with them
+    std::fill(index_page_stamps_.begin(), index_page_stamps_.end(), 0u);
+    index_stamp_ = 1;
+    ForgetIndexUploads();
+    return;
+  }
+  ++index_stamp_;
+  for (const auto& [first, last] : invalidated_) {
+    if (last < first) continue;
+    std::fill(index_page_stamps_.begin() + (first >> kIndexPageShift),
+              index_page_stamps_.begin() + (size_t(last >> kIndexPageShift) + 1), index_stamp_);
+  }
+}
+
 void Renderer::ProcessInvalidations() {
   if (!tracker_) return;
   invalidated_.clear();
