+uint64_t Renderer::GuestRangesHash(const GuestTexture& texture) const {
+  static const bool on = [] {
+    const char* v = std::getenv("BOTS_GFX_RELOAD_HASH");
+    return !(v && *v == '0');
+  }();
+  if (!on) return 0;
+  uint64_t hash = 0x51ED270B27D4EB4Full;
+  bool any = false;
+  for (const auto& [start, end] : texture.ranges) {
+    if (end <= start) continue;
+    const uint8_t* bytes = memory_(start);
+    if (!bytes) return 0;
+    hash = XXH3_64bits_withSeed(bytes, end - start, hash);
+    any = true;
+  }
+  return any && hash ? hash : 0;
+}
+
+// A dirty texture whose guest bytes are what it was loaded from: re-arm the write watch and keep the image.
+bool Renderer::KeepUnchangedTexture(GuestTexture& texture) {
+  if (!texture.content_hash || texture.prompt_atlas || !texture.image.image) return false;
+  if (GuestRangesHash(texture) != texture.content_hash) return false;
+  texture.dirty = false;
+  if (tracker_) {
+    for (const auto& [start, end] : texture.ranges) {
+      if (end > start) tracker_->Request(start, end - start);
+    }
+  }
+  if (reload_skip_lines_ < 8) {
+    ++reload_skip_lines_;
+    REXLOG_INFO("gfx native: texture {:08X} ({} bytes) written by the CPU but unchanged: kept, not reloaded",
+                texture.ranges[0].first, texture.ranges[0].second - texture.ranges[0].first);
+  }
+  return true;
+}
