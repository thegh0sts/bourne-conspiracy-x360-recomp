diff --git a/src/graphics/pipeline/texture/resolve_trace.cpp b/src/graphics/pipeline/texture/resolve_trace.cpp
new file mode 100644
index 0000000..0cd51dc
--- /dev/null
+++ b/src/graphics/pipeline/texture/resolve_trace.cpp
@@ -0,0 +1,149 @@
+/**
+ * @file        graphics/pipeline/texture/resolve_trace.cpp
+ * @brief       --resolve_trace (see resolve_trace.h).
+ *
+ * Every --resolve_trace_interval frames, records each resolve of one frame and counts the
+ * texture bindings that overlap what it wrote, in that frame and the next. A resolve that
+ * nothing binds before another resolve overwrites the same memory, or before the frame after
+ * ends, did work nobody used. The summary is logged when the frame after ends.
+ */
+
+#include <algorithm>
+#include <string>
+#include <vector>
+
+#include <fmt/format.h>
+
+#include <rex/cvar.h>
+#include <rex/graphics/resolve_trace.h>
+#include <rex/graphics/xenos.h>
+#include <rex/logging.h>
+
+REXCVAR_DEFINE_BOOL(resolve_trace, false, "GPU",
+                    "Log each resolve of one frame every --resolve_trace_interval frames, with "
+                    "its size, formats and whether its result is sampled; development only");
+REXCVAR_DEFINE_INT32(resolve_trace_interval, 600, "GPU",
+                     "Frames between two --resolve_trace frames");
+
+namespace rex::graphics::resolve_trace {
+namespace {
+
+struct Record {
+  Resolve resolve;
+  uint32_t bound_same_frame = 0;
+  uint32_t bound_next_frame = 0;
+  int32_t overwritten_by = -1;  // index of a later resolve that rewrote the range unread
+  bool closed = false;          // rewritten: stop counting
+};
+
+uint64_t g_frame = 0;
+// 0: idle; 1: recording the traced frame; 2: the frame after (counting samples only).
+int g_phase = 0;
+uint64_t g_traced_frame = 0;
+std::vector<Record> g_records;
+
+bool Overlaps(const Resolve& r, uint32_t start, uint32_t length) {
+  return r.copies && r.dest_length && start < r.dest_start + r.dest_length &&
+         r.dest_start < start + length;
+}
+
+std::string FormatName(const Resolve& r) {
+  return r.depth ? xenos::GetDepthRenderTargetFormatName(
+                       xenos::DepthRenderTargetFormat(r.source_format))
+                 : xenos::GetColorRenderTargetFormatName(
+                       xenos::ColorRenderTargetFormat(r.source_format));
+}
+
+void Flush() {
+  uint32_t copies = 0, unread = 0;
+  uint64_t pixels = 0, unread_pixels = 0;
+  for (const Record& rec : g_records) {
+    const Resolve& r = rec.resolve;
+    if (!r.copies) continue;
+    ++copies;
+    const uint64_t px = uint64_t(r.width) * r.scale_x * r.height * r.scale_y;
+    pixels += px;
+    if (!rec.bound_same_frame && !rec.bound_next_frame) {
+      ++unread;
+      unread_pixels += px;
+    }
+  }
+  REXGPU_INFO(
+      "resolve_trace: frame {}: {} resolves, {} copies ({:.2f} Mpx written at scale), {} clear "
+      "only; {} copies ({:.2f} Mpx) never bound as a texture in this or the next frame",
+      g_traced_frame, g_records.size(), copies, pixels / 1e6, g_records.size() - copies, unread,
+      unread_pixels / 1e6);
+  for (size_t i = 0; i < g_records.size(); ++i) {
+    const Record& rec = g_records[i];
+    const Resolve& r = rec.resolve;
+    std::string what =
+        r.copies ? fmt::format("-> {:08X} +{} KB, dest fmt {} bias {}", r.dest_start,
+                               r.dest_length / 1024, r.dest_format, r.dest_exp_bias)
+                 : std::string("(no copy)");
+    std::string use;
+    if (r.copies) {
+      use = fmt::format("bound {} times this frame, {} next frame", rec.bound_same_frame,
+                        rec.bound_next_frame);
+      if (rec.overwritten_by >= 0) {
+        use += fmt::format(", rewritten unread by #{}", rec.overwritten_by);
+      }
+    }
+    REXGPU_INFO("resolve_trace: #{} {} {} {}x {}x{} (x{}) tile {} {}{}{} {}", i,
+                r.depth ? "depth" : "color", FormatName(r), r.msaa_samples, r.width, r.height,
+                r.scale_x, r.edram_base_tiles, what, r.clears_color ? " +clear color" : "",
+                r.clears_depth ? " +clear depth" : "", use);
+  }
+  g_records.clear();
+}
+
+}  // namespace
+
+void OnFrame() {
+  ++g_frame;
+  if (g_phase == 2) {
+    Flush();
+    g_phase = 0;
+  } else if (g_phase == 1) {
+    g_phase = 2;
+  }
+  if (g_phase == 0 && REXCVAR_GET(resolve_trace)) {
+    const int32_t interval = std::max<int32_t>(REXCVAR_GET(resolve_trace_interval), 3);
+    if (g_frame % uint64_t(interval) == 0) {
+      g_phase = 1;
+      g_traced_frame = g_frame;
+      g_records.clear();
+    }
+  }
+}
+
+void OnResolve(const Resolve& resolve) {
+  if (g_phase == 0) return;
+  const int32_t index = int32_t(g_records.size());
+  for (Record& rec : g_records) {
+    if (rec.closed || !Overlaps(rec.resolve, resolve.dest_start, resolve.dest_length) ||
+        !resolve.copies) {
+      continue;
+    }
+    rec.closed = true;
+    if (!rec.bound_same_frame && !rec.bound_next_frame && g_phase == 1) {
+      rec.overwritten_by = index;
+    }
+  }
+  if (g_phase == 1 && g_records.size() < 4096) {
+    g_records.push_back(Record{resolve});
+  }
+}
+
+void OnSample(uint32_t start, uint32_t length) {
+  if (g_phase == 0) return;
+  for (Record& rec : g_records) {
+    if (rec.closed || !Overlaps(rec.resolve, start, length)) continue;
+    if (g_phase == 1) {
+      ++rec.bound_same_frame;
+    } else {
+      ++rec.bound_next_frame;
+    }
+  }
+}
+
+}  // namespace rex::graphics::resolve_trace
