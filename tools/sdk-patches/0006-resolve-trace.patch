+/**
+ * @file        graphics/resolve_trace.h
+ * @brief       --resolve_trace: log the resolves (EDRAM -> texture copies) of one frame,
+ *              and whether anything samples what they write. Development only.
+ */
+#pragma once
+
+#include <cstdint>
+
+namespace rex::graphics::resolve_trace {
+
+struct Resolve {
+  uint32_t width = 0, height = 0;  // in guest pixels, before the draw resolution scale
+  uint32_t scale_x = 1, scale_y = 1;
+  bool depth = false;          // copying the depth buffer (else a color render target)
+  uint32_t source_format = 0;  // xenos::ColorRenderTargetFormat / DepthRenderTargetFormat
+  uint32_t msaa_samples = 1;
+  uint32_t edram_base_tiles = 0;
+  bool copies = false;  // false: a clear only
+  uint32_t dest_start = 0, dest_length = 0;
+  uint32_t dest_format = 0;  // xenos::ColorFormat
+  int32_t dest_exp_bias = 0;
+  bool clears_color = false, clears_depth = false;
+};
+
+// All three run on the GPU command processor thread.
+void OnFrame();
+void OnResolve(const Resolve& resolve);
+// A texture binding at [start, start + length) of guest memory.
+void OnSample(uint32_t start, uint32_t length);
+
+}  // namespace rex::graphics::resolve_trace
