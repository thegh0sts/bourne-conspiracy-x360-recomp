+// The modifier bit a key is itself (Shift, Ctrl, Alt, either side), else 0.
+uint8_t ModifierOf(rex::ui::VirtualKey vk) {
+  using rex::ui::VirtualKey;
+  switch (vk) {
+    case VirtualKey::kShift:
+    case VirtualKey::kLShift:
+    case VirtualKey::kRShift:
+      return kModShift;
+    case VirtualKey::kControl:
+    case VirtualKey::kLControl:
+    case VirtualKey::kRControl:
+      return kModCtrl;
+    case VirtualKey::kMenu:
+    case VirtualKey::kLMenu:
+    case VirtualKey::kRMenu:
+      return kModAlt;
+    default:
+      return 0;
+  }
+}
+
+// tbc: a plain bind ("W", "Shift") fires whatever modifiers are held, and a modifier bind
+// ("Shift+Up") when at least its modifiers are held. Exact matching made a bare modifier bind
+// unusable (holding Shift sets the very modifier the bind says must be up) and stopped every
+// other key while one was held: Shift bound to a shoulder button (sprint) never fired, and
+// would have stopped W/A/S/D while sprinting. The cost: "Up" also fires with Shift+Up held.
 bool TokenPressed(const bool (&key_down)[256], std::string_view token, uint8_t live_mods) {
   uint8_t want = TakeModifiers(token);
-  if (want != live_mods) {
-    return false;
-  }
   rex::ui::VirtualKey vk = rex::ui::ParseVirtualKey(token);
   if (vk == rex::ui::VirtualKey::kNone) {
     return false;
   }
+  const uint8_t held = live_mods & ~ModifierOf(vk);
+  if ((held & want) != want) {
+    return false;
+  }
   uint16_t idx = static_cast<uint16_t>(vk);
   return idx < 256 && key_down[idx];
 }
