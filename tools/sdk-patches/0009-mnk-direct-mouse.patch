+void SetMouseDirect(bool direct) {
+  mouse_direct.store(direct, std::memory_order_relaxed);
+}
+
+bool ConsumeMouseDelta(float* dx, float* dy) {
+  std::lock_guard<std::mutex> lock(mouse_direct_mutex);
+  const bool any = mouse_direct_dx != 0.0 || mouse_direct_dy != 0.0;
+  if (dx) *dx = float(mouse_direct_dx);
+  if (dy) *dy = float(mouse_direct_dy);
+  mouse_direct_dx = mouse_direct_dy = 0.0;
+  return any;
+}
