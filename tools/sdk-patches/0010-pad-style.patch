+// The first controller's style, for the game's button prompts (pad_style.h).
+static void PublishPadStyle(SDL_Gamepad* first) {
+  PadStyle style = PadStyle::kNone;
+  if (first) {
+    switch (SDL_GetGamepadType(first)) {
+      case SDL_GAMEPAD_TYPE_PS3:
+      case SDL_GAMEPAD_TYPE_PS4:
+      case SDL_GAMEPAD_TYPE_PS5:
+        style = PadStyle::kPlayStation;
+        break;
+      default:
+        style = PadStyle::kXbox;
+        break;
+    }
+  }
+  SetConnectedPadStyle(style);
+}
